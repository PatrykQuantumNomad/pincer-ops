    // Detail panel with ARIA and keyboard support
    let lastFocusedElement = null;

    function showDetail(key) {
      const d = details[key];
      if (!d) return;
      const panel = document.getElementById('detailPanel');
      const content = document.getElementById('detailContent');
      lastFocusedElement = document.activeElement;
      content.innerHTML =
        '<h2>' + d.title + '</h2>' +
        '<p>' + d.desc + '</p>' +
        '<h3>Key Files</h3>' +
        '<ul class="file-list">' + d.files.map(f => '<li>' + f + '</li>').join('') + '</ul>' +
        '<h3>Key Concepts</h3>' +
        '<ul>' + d.concepts.map(c => '<li>' + c + '</li>').join('') + '</ul>';
      panel.classList.add('open');
      panel.setAttribute('aria-hidden', 'false');
      document.getElementById('closeDetailBtn').focus();
    }

    function closeDetail() {
      const panel = document.getElementById('detailPanel');
      panel.classList.remove('open');
      panel.setAttribute('aria-hidden', 'true');
      if (lastFocusedElement) lastFocusedElement.focus();
    }

    document.getElementById('closeDetailBtn').addEventListener('click', closeDetail);

    // Make arch-boxes keyboard accessible
    document.querySelectorAll('[data-detail]').forEach(el => {
      el.setAttribute('tabindex', '0');
      el.setAttribute('role', 'button');
      el.addEventListener('click', () => showDetail(el.dataset.detail));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          showDetail(el.dataset.detail);
        }
      });
    });

    // Escape key closes detail panel
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDetail();
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      const panel = document.getElementById('detailPanel');
      if (panel.classList.contains('open') && !panel.contains(e.target) && !e.target.closest('[data-detail]')) {
        closeDetail();
      }
    });
