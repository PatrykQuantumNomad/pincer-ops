---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import OpenClaw from '../components/OpenClaw.astro';
import NemoClaw from '../components/NemoClaw.astro';
import OpenShell from '../components/OpenShell.astro';
import Architecture from '../components/Architecture.astro';
import Features from '../components/Features.astro';
import Stack from '../components/Stack.astro';
import Ecosystem from '../components/Ecosystem.astro';
import QuickStart from '../components/QuickStart.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Pincer Ops — Grip your cluster">
  <Nav />
  <main id="main-content" class="relative z-10">
    <Hero />
    <OpenClaw />
    <NemoClaw />
    <OpenShell />
    <Architecture />
    <Features />
    <Stack />
    <Ecosystem />
    <QuickStart />
  </main>
  <Footer />
</Layout>
