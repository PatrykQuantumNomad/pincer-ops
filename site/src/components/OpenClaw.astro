---
const capabilities = [
  {
    icon: '&#x1F4AC;',
    title: '14+ Platforms',
    desc: 'WhatsApp, Telegram, Discord, Slack, Signal, iMessage, Teams, and more.',
    wide: true,
  },
  {
    icon: '&#x1F9E0;',
    title: 'AI Skills',
    desc: 'ClawHub ecosystem with 50+ integrations. Browser automation, voice, Canvas.',
    wide: false,
  },
  {
    icon: '&#x1F512;',
    title: 'Privacy-First',
    desc: 'Self-hosted, local-first. Your data never leaves your infrastructure.',
    wide: false,
  },
  {
    icon: '&#x26A1;',
    title: 'Gateway Runtime',
    desc: 'Node.js gateway on port 18789. WebSocket-based, single-instance, PVC-backed.',
    wide: true,
  },
];
---

<section id="openclaw" class="relative py-32 px-6 bg-section-coral">
  <div class="max-w-6xl mx-auto">
    <!-- Section header — left-aligned on md+ -->
    <div class="text-center md:text-left mb-16 fade-in">
      <span class="font-mono text-xs text-coral tracking-widest uppercase">The Workload</span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-light mt-3">
        What is <span class="text-coral glow-coral">OpenClaw</span>?
      </h2>
      <p class="text-dim mt-4 max-w-2xl">
        OpenClaw is a personal AI assistant that actually does things.
        It runs locally on your hardware, connects to 14+ messaging platforms,
        and extends through a growing Skills ecosystem.
      </p>
    </div>

    <!-- GitHub stars badge -->
    <!-- Update star count periodically. Last checked: 2026-02-21. GitHub API: https://api.github.com/repos/OpenClaw/OpenClaw -->
    <div class="flex justify-center md:justify-start mb-12 fade-in">
      <a href="https://github.com/OpenClaw/OpenClaw"
         target="_blank" rel="noopener"
         class="inline-flex items-center gap-3 px-5 py-2.5 rounded-lg glass-card
                hover:border-neon-cyan/30 transition-all group">
        <svg class="w-5 h-5 text-light" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <div class="flex flex-col">
          <span class="font-mono text-xs text-muted">OpenClaw/OpenClaw</span>
          <span class="font-display font-bold text-light group-hover:text-neon-cyan transition-colors">
            215K+ stars
          </span>
        </div>
        <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
      </a>
    </div>

    <!-- Capability cards — bento grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto md:mx-0">
      {capabilities.map((cap) => (
        <div class={`fade-in glass-card p-6 hover:border-neon-cyan/30 transition-colors group ${cap.wide ? 'lg:col-span-2' : ''}`}>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl" set:html={cap.icon} />
            <h3 class="font-mono font-bold text-light group-hover:text-neon-cyan transition-colors">
              {cap.title}
            </h3>
          </div>
          <p class="text-dim text-sm leading-relaxed">{cap.desc}</p>
        </div>
      ))}
    </div>

    <!-- Bridge: why self-host with Pincer -->
    <div class="text-center md:text-left mt-12 fade-in max-w-xl">
      <p class="text-dim text-sm leading-relaxed">
        Pincer Ops gives OpenClaw a
        <span class="text-neon-cyan">production-grade Kubernetes home</span> with
        <span class="text-neon-cyan">kernel-level sandbox isolation</span>.<br />
        GitOps deployment, mTLS, encrypted secrets, automated backups,
        and Landlock + seccomp-BPF security. One command to deploy it all.
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('#openclaw .fade-in').forEach((el, i) => {
      gsap.fromTo(el,
        { opacity: 0, scale: 0.92 },
        {
          opacity: 1,
          scale: 1,
          duration: 0.6,
          delay: i * 0.08,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
        }
      );
    });
  }
</script>
