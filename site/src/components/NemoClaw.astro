---
const capabilities = [
  {
    icon: '&#x1F4E6;',
    title: 'Blueprint System',
    desc: 'Versioned Python orchestration layer managing sandbox creation, security policies, and inference configuration.',
    wide: true,
  },
  {
    icon: '&#x1F30D;',
    title: 'Network Control',
    desc: 'Egress filtering with hot-reloadable rules and operator approval. Blocks unauthorized outbound connections from sandboxed agents.',
    wide: false,
  },
  {
    icon: '&#x1F916;',
    title: 'Multi-Provider Inference',
    desc: 'Route inference through NVIDIA NIM, OpenAI, or Anthropic. Privacy router switches providers at runtime without redeployment.',
    wide: false,
  },
  {
    icon: '&#x1F4F1;',
    title: 'Telegram Bridge',
    desc: 'Always-on assistant connected to Telegram with sandboxed execution, monitoring, and conversation history.',
    wide: true,
  },
];
---

<section id="nemoclaw" class="relative py-32 px-6 bg-section-emerald">
  <div class="max-w-6xl mx-auto">
    <!-- Section header — left-aligned on md+ -->
    <div class="text-center md:text-left mb-16 fade-in">
      <span class="font-mono text-xs text-emerald tracking-widest uppercase">Under Evaluation</span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-light mt-3">
        What is <span class="text-emerald glow-emerald">NemoClaw</span>?
      </h2>
      <p class="text-dim mt-4 max-w-2xl">
        NemoClaw is NVIDIA's open-source reference stack for running OpenClaw
        assistants safely. It combines OpenShell's sandbox runtime with NVIDIA
        Nemotron models. We are evaluating NemoClaw's architecture for future
        integration into Pincer Ops.
      </p>
    </div>

    <!-- GitHub badge -->
    <div class="flex justify-center md:justify-start mb-12 fade-in">
      <a href="https://github.com/NVIDIA/NemoClaw"
         target="_blank" rel="noopener"
         class="inline-flex items-center gap-3 px-5 py-2.5 rounded-lg glass-card
                hover:border-neon-cyan/30 transition-all group">
        <svg class="w-5 h-5 text-light" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <div class="flex flex-col">
          <span class="font-mono text-xs text-muted">NVIDIA/NemoClaw</span>
          <span class="font-display font-bold text-light group-hover:text-neon-cyan transition-colors">
            Alpha
          </span>
        </div>
        <span class="font-mono text-xs px-2 py-0.5 rounded bg-amber-500/20 text-amber-400">Alpha</span>
      </a>
    </div>

    <!-- Capability cards — bento grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto md:mx-0">
      {capabilities.map((cap) => (
        <div class={`fade-in glass-card p-6 hover:border-neon-cyan/30 transition-colors group ${cap.wide ? 'lg:col-span-2' : ''}`}>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl" set:html={cap.icon} />
            <h3 class="font-mono font-bold text-light group-hover:text-neon-cyan transition-colors">
              {cap.title}
            </h3>
          </div>
          <p class="text-dim text-sm leading-relaxed">{cap.desc}</p>
        </div>
      ))}
    </div>

    <!-- Bridge: how Pincer Ops relates to NemoClaw -->
    <div class="text-center md:text-left mt-12 fade-in max-w-xl">
      <p class="text-dim text-sm leading-relaxed">
        We are testing the
        <span class="text-emerald">OpenShell runtime layer</span> that NemoClaw
        builds upon. A future Pincer Ops milestone may integrate NemoClaw's
        sandbox isolation, blueprint orchestration, and privacy router
        for enhanced agent security.
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('#nemoclaw .fade-in').forEach((el, i) => {
      gsap.fromTo(el,
        { opacity: 0, scale: 0.92 },
        {
          opacity: 1,
          scale: 1,
          duration: 0.6,
          delay: i * 0.08,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
        }
      );
    });
  }
</script>
